# Copy this file to .env and adjust as needed.
# docker-compose automatically reads a .env file in this directory.

# Shared secret used by user-service to sign JWTs, and by cart-service /
# order-service / api-gateway to verify them. Change this for any real deployment.
JWT_SECRET=dev_super_secret_change_me
JWT_EXPIRES_IN=7d

# Origin allowed to call the API gateway (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# Base URL the frontend uses to reach the API gateway from the browser.
VITE_API_URL=http://localhost:4000
