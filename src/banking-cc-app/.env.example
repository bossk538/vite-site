# Copy this file to .env and adjust as needed.
# docker-compose automatically reads a .env file in this directory.

# Secret used to sign/verify JWTs. Change this for anything beyond local demo use.
JWT_SECRET=dev_super_secret_change_me
JWT_EXPIRES_IN=7d

# Origin allowed to call the backend API (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# Base URL the frontend uses to reach the backend from the browser.
VITE_API_URL=http://localhost:4000
