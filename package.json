{
  "name": "vite-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --host",
    "setcap": "sudo setcap 'cap_net_bind_service=+ep' $(which node)",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext .ts,.tsx",
    "preview": "vite preview",
    "test": "vitest --config vitest.config.ts",
    "test:storybook": "vitest --config vitest.storybook.config.ts",
    "test:all": "npm run test -- --run && npm run test:storybook -- --run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@react-router/dev": "^7.9.3",
    "@react-router/node": "^7.9.3",
    "@stringsync/musicxml": "^0.4.0",
    "axios": "^1.20.0",
    "brain.js": "^2.0.0-beta.24",
    "d3": "^7.9.0",
    "isbot": "^5",
    "liquid-glass-react": "^1.1.1",
    "ml-kmeans": "^7.0.1",
    "opensheetmusicdisplay": "^2.2.1",
    "osmd-audio-player": "^0.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^16.5.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^31.0.0",
    "playwright": "latest",
    "storybook": "^10.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.7",
    "vitest": "latest"
  }
}
